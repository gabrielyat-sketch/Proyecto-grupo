# Variables del servicio. Copiar a .env y ajustar.
# Al generar un servicio nuevo desde esta plantilla, se cambian el puerto,
# el nombre y el esquema de base de datos.
NODE_ENV=development
LOG_LEVEL=debug
PUERTO=3004
NOMBRE_SERVICIO=medicamentos

# Usuario de EJECUCION: solo lee y escribe datos.
DATABASE_URL=postgresql://cap_medicamentos:dev_medicamentos@localhost:5432/cap?schema=medicamentos
# Usuario DUENO: solo lo usa `prisma migrate`.
DIRECT_URL=postgresql://cap_migrador:dev_migrador@localhost:5432/cap?schema=medicamentos

JWT_SECRET=CAMBIAR_minimo_32_caracteres_en_produccion
JWT_EXPIRACION=15m

# URL interna del servicio de usuarios. Se consulta para validar que el
# paciente exista al registrar una entrega.
URL_USUARIOS=http://localhost:3002
TIMEOUT_USUARIOS_MS=2000

# Cuantos dias antes de vencer se considera que un lote esta "por vencer".
# 90 dias da margen para devolverlo al proveedor o redistribuirlo a otro
# servicio de salud antes de que haya que darlo de baja.
DIAS_ALERTA_VENCIMIENTO=90
