{
  "name": "@cap/usuarios",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de Informacion de Usuarios: pacientes, expedientes y atenciones.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "lint": "tsc --noEmit",
    "prisma:migrar": "prisma migrate dev",
    "prisma:generar": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "carga": "tsx prisma/carga-prueba.ts",
    "contrato": "ts-node --project tsconfig.json scripts/exportar-contrato.ts",
    "catalogo": "ts-node --project tsconfig.json prisma/catalogo-ficha-adulto.ts",
    "catalogo:neonato": "ts-node --project tsconfig.json prisma/catalogo-ficha-neonato.ts",
    "catalogo:ninez": "ts-node --project tsconfig.json prisma/catalogo-ficha-ninez.ts",
    "lugares": "ts-node --project tsconfig.json prisma/lugares-poblados.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
