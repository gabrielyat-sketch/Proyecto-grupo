# Variables del servicio. Copiar a .env y ajustar.
# Al generar un servicio nuevo desde esta plantilla, se cambian el puerto,
# el nombre y el esquema de base de datos.
NODE_ENV=development
LOG_LEVEL=debug
PUERTO=3002
NOMBRE_SERVICIO=usuarios

# Usuario de EJECUCION: solo lee y escribe datos.
DATABASE_URL=postgresql://cap_usuarios:dev_usuarios@localhost:5433/cap?schema=usuarios
# Usuario DUENO: solo lo usa `prisma migrate`.
DIRECT_URL=postgresql://cap_migrador:dev_migrador@localhost:5433/cap?schema=usuarios

JWT_SECRET=CAMBIAR_minimo_32_caracteres_en_produccion
JWT_EXPIRACION=15m

# Cifrado de campos sensibles. DEBEN ser las mismas llaves que usan los demas
# servicios: si difieren, un DPI cifrado por un servicio no lo puede descifrar
# ni buscar el otro.
LLAVE_DATOS=CAMBIAR_64_caracteres_hex
LLAVE_INDICE=CAMBIAR_64_caracteres_hex
