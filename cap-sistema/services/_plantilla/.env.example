# Variables del servicio. Copiar a .env y ajustar.
# Al generar un servicio nuevo desde esta plantilla, se cambian el puerto,
# el nombre y el esquema de base de datos.
NODE_ENV=development
LOG_LEVEL=debug
PUERTO=3100  # la plantilla no se despliega; 3001-3008 son de los servicios reales
NOMBRE_SERVICIO=plantilla

# Usuario de EJECUCION: solo lee y escribe datos.
DATABASE_URL=postgresql://cap_plantilla:dev_plantilla@localhost:5433/cap?schema=plantilla
# Usuario DUENO: solo lo usa `prisma migrate`.
DIRECT_URL=postgresql://cap_migrador:dev_migrador@localhost:5433/cap?schema=plantilla

JWT_SECRET=CAMBIAR_minimo_32_caracteres_en_produccion
JWT_EXPIRACION=15m
