# Variables del servicio de trazabilidad. Copiar a .env y ajustar.
NODE_ENV=development
LOG_LEVEL=debug
PUERTO=3007
NOMBRE_SERVICIO=trazabilidad

# Usuario de EJECUCION. Tiene SELECT e INSERT, y NO tiene UPDATE ni DELETE
# (infra/postgres/init.sql). Es la restriccion que sostiene el RF-09: ni la
# propia aplicacion puede alterar la bitacora. No la "arregles" para que pase
# una prueba.
DATABASE_URL=postgresql://cap_trazabilidad:dev_trazabilidad@localhost:5433/cap?schema=trazabilidad
# Usuario DUENO: solo lo usa `prisma migrate`.
DIRECT_URL=postgresql://cap_migrador:dev_migrador@localhost:5433/cap?schema=trazabilidad

JWT_SECRET=CAMBIAR_minimo_32_caracteres_en_produccion
JWT_EXPIRACION=15m

# Cifrado de los valores clinicos que viajan en la bitacora (el mismo par de
# llaves del resto del sistema).
LLAVE_DATOS=CAMBIAR_64_caracteres_hex
LLAVE_INDICE=CAMBIAR_64_caracteres_hex

# Llave de firma del hash raiz diario. VIVE FUERA DE LA BASE DE DATOS
# (arquitectura §9.5): si estuviera junto a los datos que protege, quien
# alterara la bitacora podria volver a firmar la raiz y no quedaria rastro.
# Distinta de LLAVE_DATOS a proposito: son dos compromisos separados.
LLAVE_RAIZ_TRAZA=CAMBIAR_64_caracteres_hex
