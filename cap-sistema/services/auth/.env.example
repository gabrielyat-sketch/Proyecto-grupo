# Variables del servicio. Copiar a .env y ajustar.
# Al generar un servicio nuevo desde esta plantilla, se cambian el puerto,
# el nombre y el esquema de base de datos.
NODE_ENV=development
LOG_LEVEL=debug
PUERTO=3001
NOMBRE_SERVICIO=auth

# Usuario de EJECUCION: solo lee y escribe datos.
DATABASE_URL=postgresql://cap_auth:dev_auth@localhost:5433/cap?schema=auth
# Usuario DUENO: solo lo usa `prisma migrate`.
DIRECT_URL=postgresql://cap_migrador:dev_migrador@localhost:5433/cap?schema=auth

JWT_SECRET=CAMBIAR_minimo_32_caracteres_en_produccion
JWT_EXPIRACION=15m

# Secreto APARTE para el token parcial que se emite entre el paso de
# contrasena y el de MFA. Al firmarse con otra llave, ese token no es valido
# para ningun otro servicio del sistema: aunque se filtre, no abre nada.
JWT_SECRET_MFA=CAMBIAR_otro_minimo_32_caracteres_distinto
MFA_TOKEN_EXPIRACION=5m

# Bloqueo por intentos fallidos
MAX_INTENTOS_FALLIDOS=5
VENTANA_INTENTOS_MINUTOS=15
MINUTOS_BLOQUEO=15

# Sesiones
REFRESH_EXPIRACION_DIAS=7

# Cifrado del secreto TOTP (el mismo par de llaves del resto del sistema)
LLAVE_DATOS=CAMBIAR_64_caracteres_hex
LLAVE_INDICE=CAMBIAR_64_caracteres_hex
