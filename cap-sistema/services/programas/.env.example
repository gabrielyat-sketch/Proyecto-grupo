# Variables del servicio. Copiar a .env y ajustar.
# Al generar un servicio nuevo desde esta plantilla, se cambian el puerto,
# el nombre y el esquema de base de datos.
NODE_ENV=development
LOG_LEVEL=debug
PUERTO=3003
NOMBRE_SERVICIO=programas

# Usuario de EJECUCION: solo lee y escribe datos.
DATABASE_URL=postgresql://cap_programas:dev_programas@localhost:5433/cap?schema=programas
# Usuario DUENO: solo lo usa `prisma migrate`.
DIRECT_URL=postgresql://cap_migrador:dev_migrador@localhost:5433/cap?schema=programas

JWT_SECRET=CAMBIAR_minimo_32_caracteres_en_produccion
JWT_EXPIRACION=15m

# Cifrado de las observaciones clinicas de los controles. Deben ser las mismas
# llaves que usan los demas servicios.
LLAVE_DATOS=CAMBIAR_64_caracteres_hex
LLAVE_INDICE=CAMBIAR_64_caracteres_hex
