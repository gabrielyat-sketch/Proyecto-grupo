# ══════════════════════════════════════════════════════════════════════════
#  Plantilla de variables de entorno — cap-sistema
#  Copiar a .env y rellenar. EL ARCHIVO .env NUNCA SE VERSIONA.
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=debug

# ─── Base de datos ────────────────────────────────────────────────────────
# DOS ROLES POR SERVICIO (arquitectura §9.1, ver infra/postgres/init.sql):
#
#   DATABASE_URL_*  -> usuario de EJECUCION. Lo usa la aplicacion.
#                      Solo lee y escribe datos, no puede crear tablas.
#   DIRECT_URL_*    -> usuario DUENO (cap_migrador). Lo usa SOLO
#                      'prisma migrate'. Nunca la aplicacion en ejecucion.
#
# Motivo: el dueno de una tabla en PostgreSQL tiene todos los privilegios
# sobre ella pase lo que pase. Si el servicio creara sus propias tablas,
# 'trazabilidad' podria borrar su propia auditoria. Separar dueno y ejecutor
# es lo unico que sostiene la garantia append-only.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cap

# Usuarios de ejecucion (los usa la aplicacion)
DATABASE_URL_AUTH=postgresql://cap_auth:CAMBIAR@localhost:5432/cap?schema=auth
DATABASE_URL_USUARIOS=postgresql://cap_usuarios:CAMBIAR@localhost:5432/cap?schema=usuarios
DATABASE_URL_PROGRAMAS=postgresql://cap_programas:CAMBIAR@localhost:5432/cap?schema=programas
DATABASE_URL_MEDICAMENTOS=postgresql://cap_medicamentos:CAMBIAR@localhost:5432/cap?schema=medicamentos
DATABASE_URL_REPORTES=postgresql://cap_reportes:CAMBIAR@localhost:5432/cap?schema=reportes
DATABASE_URL_CMS=postgresql://cap_cms:CAMBIAR@localhost:5432/cap?schema=cms
DATABASE_URL_TRAZABILIDAD=postgresql://cap_trazabilidad:CAMBIAR@localhost:5432/cap?schema=trazabilidad

# Usuario dueno, solo para migraciones
DIRECT_URL_AUTH=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=auth
DIRECT_URL_USUARIOS=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=usuarios
DIRECT_URL_PROGRAMAS=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=programas
DIRECT_URL_MEDICAMENTOS=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=medicamentos
DIRECT_URL_REPORTES=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=reportes
DIRECT_URL_CMS=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=cms
DIRECT_URL_TRAZABILIDAD=postgresql://cap_migrador:CAMBIAR@localhost:5432/cap?schema=trazabilidad

# ─── Redis (eventos, cache y rate limiting) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Autenticacion ────────────────────────────────────────────────────────
JWT_SECRET=CAMBIAR
JWT_EXPIRACION=15m
REFRESH_EXPIRACION=7d
MFA_EMISOR=CAP Purulha
SESION_INACTIVIDAD_MINUTOS=15

# ─── Cifrado de datos sensibles (arquitectura §9.3) ───────────────────────
# CRITICO: si se pierde LLAVE_DATOS, los expedientes quedan irrecuperables.
# Generar cada una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deben vivir FUERA de la base de datos y fuera del repositorio.
LLAVE_DATOS=CAMBIAR_64_CARACTERES_HEX
LLAVE_INDICE=CAMBIAR_64_CARACTERES_HEX

# ─── Almacenamiento de PDF y multimedia (DigitalOcean Spaces) ─────────────
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# ─── Puertos de los servicios ─────────────────────────────────────────────
PUERTO_AUTH=3001
PUERTO_USUARIOS=3002
PUERTO_PROGRAMAS=3003
PUERTO_MEDICAMENTOS=3004
PUERTO_REPORTES=3005
PUERTO_CMS=3006
PUERTO_TRAZABILIDAD=3007
PUERTO_ML=3008

# ─── Generacion de PDF ────────────────────────────────────────────────────
PDF_CONCURRENCIA=2
PDF_DOCUMENTOS_POR_NAVEGADOR=50
