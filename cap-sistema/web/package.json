{
  "name": "@cap/web",
  "version": "0.1.0",
  "private": true,
  "description": "Panel del personal del CAP Purulha",
  "type": "module",
  "scripts": {
    "dev": "node scripts/liberar-puerto.mjs 5173 && vite --host --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "api:generar": "openapi-typescript ../docs/openapi/auth.yaml -o src/api/generado/auth.ts && openapi-typescript ../docs/openapi/usuarios.yaml -o src/api/generado/usuarios.ts && openapi-typescript ../docs/openapi/programas.yaml -o src/api/generado/programas.ts && openapi-typescript ../docs/openapi/medicamentos.yaml -o src/api/generado/medicamentos.ts",
    "dev:solo": "vite --host --port 5173 --strictPort"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.102.5",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
