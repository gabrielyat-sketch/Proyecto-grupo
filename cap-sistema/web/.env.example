# Panel del personal del CAP. Copiar a .env para ajustar en local.
# Las variables deben empezar con VITE_ para que Vite las exponga al navegador.
#
# NUNCA poner secretos aqui: todo lo que empiece con VITE_ queda incrustado en
# el paquete que se descarga el navegador y es visible para cualquiera.

# Minutos de inactividad antes de cerrar la sesion (arquitectura 10.5).
# Por defecto 15. El aviso previo aparece siempre 1 minuto antes.
VITE_MINUTOS_INACTIVIDAD=15
