{
  "name": "cap-sistema",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema del CAP Purulha - monorepo de microservicios",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "web"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "mock": "prism mock docs/openapi/usuarios.yaml"
  }
}
