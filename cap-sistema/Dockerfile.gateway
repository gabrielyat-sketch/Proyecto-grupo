# Imagen del gateway: nginx con el panel ya compilado dentro.
# Se construye desde cap-sistema/:
#
#   docker build -f Dockerfile.gateway -t cap/gateway .
#
# Etapa 1 compila el panel (Vite). Etapa 2 es nginx sirviendolo y reenviando
# /api/... a los servicios (infra/nginx/gateway-interno.conf.template).

# ─── etapa 1: compilar el panel ───────────────────────────────────────────
FROM node:22-alpine AS constructor
WORKDIR /app

# Todos los package.json del workspace, por lo mismo que en
# Dockerfile.servicio: el lock describe el monorepo entero.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY services/_plantilla/package.json services/_plantilla/
COPY services/auth/package.json services/auth/
COPY services/usuarios/package.json services/usuarios/
COPY services/programas/package.json services/programas/
COPY services/medicamentos/package.json services/medicamentos/
COPY services/trazabilidad/package.json services/trazabilidad/
COPY web/package.json web/
RUN npm ci

COPY web web
# La unica variable del panel en tiempo de compilacion (opcional).
ARG VITE_MINUTOS_INACTIVIDAD
RUN npm run build -w @cap/web

# ─── etapa 2: nginx ───────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS gateway

# openssl para el certificado autofirmado de pruebas.
RUN apk add --no-cache openssl && rm -f /etc/nginx/conf.d/default.conf

COPY infra/nginx/comun/ /etc/nginx/comun/
COPY infra/nginx/gateway-interno.conf.template /etc/nginx/templates/
COPY infra/nginx/05-certificado.sh infra/nginx/06-recarga-periodica.sh /docker-entrypoint.d/
RUN chmod +x /docker-entrypoint.d/05-certificado.sh /docker-entrypoint.d/06-recarga-periodica.sh

COPY --from=constructor /app/web/dist /usr/share/nginx/html

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null --no-check-certificate https://localhost/ || exit 1
